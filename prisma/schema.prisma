generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Profile {
  id         String    @id @default(cuid())
  name       String
  hourlyRate Float?
  currency   String    @default("USD")
  createdAt  DateTime  @default(now())
  projects   Project[]
  invoices   Invoice[]
}

model Project {
  id        String      @id @default(cuid())
  name      String
  code      String?
  client    String?
  color     String      @default("#3B82F6")
  status    String      @default("active")
  profileId String
  profile   Profile     @relation(fields: [profileId], references: [id])
  parts     Part[]
  entries   TimeEntry[]
  createdAt DateTime    @default(now())
}

model Part {
  id             String      @id @default(cuid())
  name           String
  estimatedHours Float?
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id])
  entries        TimeEntry[]
}

model TimeEntry {
  id          String   @id @default(cuid())
  date        DateTime
  startTime   String
  endTime     String
  duration    Int
  description String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  partId      String?
  part        Part?    @relation(fields: [partId], references: [id])
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  createdAt   DateTime @default(now())
}

model Invoice {
  id          String      @id @default(cuid())
  number      Int
  profileId   String
  profile     Profile     @relation(fields: [profileId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  totalHours  Float
  totalAmount Float?
  status      String      @default("draft")
  paidAt      DateTime?
  entries     TimeEntry[]
  createdAt   DateTime    @default(now())
}
